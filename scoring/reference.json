{
  "experiments": {
    "synthetic_math_stale_grpo": {
      "description": "Scaled verifiable-reward reproduction of the paper's stale-sampling claim on deterministic synthetic arithmetic: humanline GRPO should maintain answer accuracy when training on stale/off-policy generated groups.",
      "weight": 1.0,
      "primary_metric": "pass_at_1",
      "metrics": {
        "pass_at_1": {
          "higher_is_better": true,
          "coefficient": 1.0,
          "description": "Exact answer accuracy on the scored arithmetic prompts."
        },
        "mean_reward": {
          "higher_is_better": true,
          "coefficient": 0.4,
          "description": "Average verifiable reward combining exact correctness with the small format bonus."
        },
        "format_rate": {
          "higher_is_better": true,
          "coefficient": 0.0,
          "description": "Diagnostic fraction of completions using the expected answer-tag format; exact correctness and mean reward carry the scored answer-quality signal."
        },
        "numeric_mae": {
          "higher_is_better": false,
          "coefficient": -0.25,
          "description": "Mean absolute numeric error after parsing the tagged answer, penalizing near-miss and constant-answer shortcuts."
        },
        "carry_pass_at_1": {
          "higher_is_better": true,
          "coefficient": 0.35,
          "description": "Exact answer accuracy restricted to prompts whose ones digits require carrying."
        },
        "unique_prompt_rate": {
          "higher_is_better": true,
          "coefficient": 0.0,
          "description": "Diagnostic fraction of scored prediction rows with distinct prompts; minimum slice-size and unique-prompt checks enforce coverage."
        },
        "evaluated_rows": {
          "higher_is_better": true,
          "coefficient": 0.0,
          "description": "Diagnostic count of rows included in the slice after prompt-hash filtering."
        },
        "stale_refresh_interval": {
          "higher_is_better": true,
          "coefficient": 0.0,
          "description": "Diagnostic stale-data reuse interval reported by the method artifact."
        },
        "generated_examples": {
          "higher_is_better": false,
          "coefficient": -0.1,
          "description": "Generated training examples consumed, used as a resource constraint."
        },
        "initial_pass_at_1": {
          "higher_is_better": false,
          "coefficient": -0.1,
          "description": "Initial model accuracy before post-training, discouraging gains from starting with a stronger model."
        }
      },
      "results": {
